
def check_obstacle(distance):
    if distance < 15:
        return "STOP"
    elif distance < 30:
        return "SLOW"
    elif distance <= 50:
        return "CAUTION"
    else:
        return "MOVE FORWARD"


readings = [80, 65, 48, 52, 25, 25, 18, 10]

for i in range(1, len(readings)):
    previous = readings[i - 1]
    current = readings[i]

    if current < previous:
        trend = "GETTING CLOSER"
    elif current > previous:
        trend = "GETTING FARTHER"
    else:
        trend = "UNCHANGED"

    action = check_obstacle(current)

    print(current, "cm |", trend, "|", action)
